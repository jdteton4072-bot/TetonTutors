# Railway Postgres connection string (Railway → Postgres service → Variables →
# DATABASE_URL, or DATABASE_PUBLIC_URL when connecting from outside Railway).
# Used by the app, Drizzle migrations, Better Auth, and the seed script.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.railway.app:PORT/railway

# Better Auth. Generate a secret with: openssl rand -base64 32
# BETTER_AUTH_URL is the public URL of the app (your Cloudflare-fronted
# domain in production, http://localhost:3000 in development).
BETTER_AUTH_SECRET=replace-with-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000
